{
  "name": "ebuyeruk/laravel-totem",
  "description": "A Laravel package to manage your cron jobs through a beautiful dashboard",
  "keywords": [
    "laravel",
    "schedule",
    "manager",
    "totem"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Roshan Gautam",
      "email": "roshan.gautam@hotmail.com",
      "homepage": "https://twitter.com/@roshangautam",
      "role": "Original Developer"
    },
    {
      "name": "Ebuyer UK Ltd",
      "email": "customerservice@ebuyer.com",
      "homepage": "https://www.ebuyer.com",
      "role": "Current Maintainer"
    },
    {
      "name": "Chris Cutts",
      "email": "chris.cutts@ebuyer.com",
      "homepage": "https://github.com/Chris-Cutts",
      "role": "Lead Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "illuminate/bus": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/console": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/contracts": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/events": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/notifications": "^9.0|^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "pestphp/pest": "^3.8"
  },
  "suggest": {
    "nexmo/client": "Required for sms notifications."
  },
  "autoload": {
    "psr-4": {
      "Ebuyer\\Totem\\": "src/",
      "Ebuyer\\Totem\\Tests\\": "tests/",
      "Database\\Factories\\": "database/factories/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "extra": {
    "component": "package",
    "branch-alias": {
      "dev-12.0": "12.x-dev"
    },
    "laravel": {
      "providers": [
        "Ebuyer\\Totem\\Providers\\TotemServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev"
}
